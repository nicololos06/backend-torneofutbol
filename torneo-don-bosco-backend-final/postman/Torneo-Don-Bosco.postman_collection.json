{
  "info": {
    "name": "Torneo Don Bosco — Entrega Final",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden contra npm run demo. Usa datos de prueba nuevos, guarda token/IDs y elimina solo sus equipos y partido al terminar. El usuario de prueba queda desactivado. Credenciales públicas solo para desarrollo."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@donbosco.example"
    },
    {
      "key": "adminPassword",
      "value": "DonBoscoDemo2026!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "equipoLocalId",
      "value": ""
    },
    {
      "key": "equipoVisitanteId",
      "value": ""
    },
    {
      "key": "partidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Estado y autenticación",
      "item": [
        {
          "name": "Estado de API y MongoDB",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin y guardar token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar consulta de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Consulta de prueba\",\n  \"email\": \"consulta.{{runId}}@example.com\",\n  \"password\": \"PruebaSegura2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString() + Math.floor(Math.random() * 10000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('usuarioId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/usuarios?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Asignar rol organizador",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rol\": \"organizador\",\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. CRUD de equipos",
      "item": [
        {
          "name": "Listar equipos de grupo A",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/equipos?grupo=A&page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear equipo local",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/equipos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Local {{runId}}\",\n  \"nombreCorto\": \"Prueba\",\n  \"grupo\": \"A\",\n  \"categoria\": \"Juvenil\",\n  \"colores\": [\n    \"azul\",\n    \"blanco\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('equipoLocalId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear equipo visitante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/equipos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Visitante {{runId}}\",\n  \"nombreCorto\": \"Prueba\",\n  \"grupo\": \"A\",\n  \"categoria\": \"Juvenil\",\n  \"colores\": [\n    \"azul\",\n    \"blanco\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('equipoVisitanteId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener equipo local",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/equipos/{{equipoLocalId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar equipo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/equipos/{{equipoLocalId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCorto\": \"Local editado\",\n  \"colores\": [\n    \"rojo\",\n    \"blanco\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. CRUD de partidos y relaciones",
      "item": [
        {
          "name": "Listar partidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/partidos?fase=grupos&page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear partido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/partidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoLocalId\": \"{{equipoLocalId}}\",\n  \"equipoVisitanteId\": \"{{equipoVisitanteId}}\",\n  \"fase\": \"grupos\",\n  \"jornada\": 4,\n  \"fechaHora\": \"2026-10-20T18:00:00-03:00\",\n  \"sede\": \"Cancha de prueba\",\n  \"estado\": \"programado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('partidoId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Leer partido con populate",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/partidos/{{partidoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Equipos completos con populate', () => { const p = pm.response.json().data; pm.expect(p.equipoLocalId).to.have.property('nombre'); pm.expect(p.equipoVisitanteId).to.have.property('nombre'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar y finalizar partido",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/partidos/{{partidoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"finalizado\",\n  \"resultado\": {\n    \"golesLocal\": 2,\n    \"golesVisitante\": 1,\n    \"definidoPor\": \"tiempo_reglamentario\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Posiciones calculadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posiciones?categoria=Juvenil"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Equipo referenciado no se puede borrar",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/equipos/{{equipoLocalId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Limpieza de los registros de esta ejecución",
      "item": [
        {
          "name": "Eliminar partido de prueba",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/partidos/{{partidoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar equipo local de prueba",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/equipos/{{equipoLocalId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar equipo visitante de prueba",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/equipos/{{equipoVisitanteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Desactivar usuario de prueba conservando historial",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Partido eliminado devuelve 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/partidos/{{partidoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
